loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

local.file_match "mauna_backend" {
  path_targets = [
    {
      "__path__" = "/var/log/mauna/*.log",
      "app" = "mauna-backend",
      "service_name" = "mauna-backend",
    },
  ]
  sync_period = "5s"
}

loki.source.file "mauna_backend" {
  targets    = local.file_match.mauna_backend.targets
  forward_to = [loki.write.local.receiver]
}
