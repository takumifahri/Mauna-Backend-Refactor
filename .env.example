DB_USER=fahriyouruser
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mauna_db
DB_URL=postgres://fahriyouruser:yourpassword@localhost:5432/mauna_db?sslmode=disable

APP_PORT=8081
APP_DEBUG=true
LOG_LEVEL=info
LOG_FILE=logs/mauna-api.log
JWT_SECRET_KEY=change-this-secret
COOKIE_SECURE=false
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Mauna

OTEL_SERVICE_NAME=mauna-backend
OTEL_SERVICE_VERSION=2.0.0
OTEL_TRACES_EXPORTER=stdout
# Use otlp when sending traces to Jaeger or an OpenTelemetry Collector.
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
